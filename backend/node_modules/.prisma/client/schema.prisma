// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  VISITOR
  PARTICIPANT
  ORGANIZER
  JUDGE
  ADMIN
}

enum Track {
  OPTIC
  NEURAL
  SOCIAL
}

enum TeamStatus {
  REGISTERED
  CONFIRMED
  ROUND1
  ROUND2
  ROUND3
  ROUND4
  FINALIST
  WINNER
  DISQUALIFIED
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum RoundStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum AnnouncementType {
  INFO
  WARNING
  RESULT
  URGENT
}

enum AnnouncementTarget {
  ALL
  QUALIFIED
  DISQUALIFIED
  TRACK_OPTIC
  TRACK_NEURAL
  TRACK_SOCIAL
}

enum SponsorTier {
  TITLE
  PLATINUM
  GOLD
  SILVER
  COMMUNITY
}

enum Society {
  PHOTONICS
  CS
  WIE
  STUDENT_BRANCH
}

enum FAQCategory {
  REGISTRATION
  ELIGIBILITY
  TECHNICAL
  EVENT_DAY
}

enum ContentType {
  TEXT
  MARKDOWN
  URL
  JSON
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @db.VarChar(255)
  role            Role     @default(PARTICIPANT)
  name            String   @db.VarChar(100)
  bio             String?  @db.Text
  profilePhotoUrl String?  @db.VarChar(500)
  instagramHandle String?  @db.VarChar(100)
  linkedinUrl     String?  @db.VarChar(500)
  githubUrl       String?  @db.VarChar(500)
  college         String?  @db.VarChar(200)
  branch          String?  @db.VarChar(100)
  yearOfStudy     Int?
  phone           String?  @db.VarChar(20)
  collegeIdUrl    String?  @db.VarChar(500)
  emailVerified   Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  createdTeams           Team[]            @relation("TeamCreator")
  teamMemberships        TeamMember[]
  judgedScores           TeamRoundScore[]  @relation("ScoreJudge")
  publishedAnnouncements Announcement[]    @relation("AnnouncementPublisher")
  notifications          Notification[]
  organizerProfile       OrganizerProfile?
  updatedContentBlocks   ContentBlock[]    @relation("ContentUpdater")
  refreshTokens          RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  email     String   @db.VarChar(255)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  email     String   @db.VarChar(255)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Team {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  description String?    @db.Text
  track       Track
  inviteCode  String     @unique @db.VarChar(10)
  status      TeamStatus @default(REGISTERED)
  createdById Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  createdBy  User             @relation("TeamCreator", fields: [createdById], references: [id])
  members    TeamMember[]
  scores     TeamRoundScore[]
  submission Submission?

  @@map("teams")
}

model TeamMember {
  id       Int            @id @default(autoincrement())
  teamId   Int
  userId   Int
  role     TeamMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Round {
  id               Int         @id @default(autoincrement())
  name             String      @db.VarChar(100)
  roundNumber      Int
  startTime        DateTime?
  endTime          DateTime?
  status           RoundStatus @default(PENDING)
  teamsExpectedIn  Int?
  teamsExpectedOut Int?
  description      String?     @db.Text
  createdAt        DateTime    @default(now())

  // Relations
  scores TeamRoundScore[]

  @@map("rounds")
}

model TeamRoundScore {
  id          Int      @id @default(autoincrement())
  teamId      Int
  roundId     Int
  judgeId     Int
  score       Decimal  @db.Decimal(5, 2)
  notes       String?  @db.Text
  isQualified Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  judge User  @relation("ScoreJudge", fields: [judgeId], references: [id])

  @@unique([teamId, roundId, judgeId])
  @@map("team_round_scores")
}

model Submission {
  id            Int              @id @default(autoincrement())
  teamId        Int              @unique
  githubUrl     String?          @db.VarChar(500)
  demoVideoUrl  String?          @db.VarChar(500)
  projectTitle  String?          @db.VarChar(200)
  description   String?          @db.Text
  status        SubmissionStatus @default(DRAFT)
  submittedAt   DateTime?
  lastUpdatedAt DateTime         @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model Announcement {
  id            Int                @id @default(autoincrement())
  title         String             @db.VarChar(200)
  body          String             @db.Text
  type          AnnouncementType   @default(INFO)
  target        AnnouncementTarget @default(ALL)
  publishedById Int
  publishedAt   DateTime           @default(now())
  createdAt     DateTime           @default(now())

  publishedBy   User           @relation("AnnouncementPublisher", fields: [publishedById], references: [id])
  notifications Notification[]

  @@map("announcements")
}

model Notification {
  id             Int              @id @default(autoincrement())
  userId         Int
  announcementId Int?
  title          String           @db.VarChar(200)
  body           String           @db.Text
  type           AnnouncementType @default(INFO)
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model Sponsor {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(200)
  logoUrl      String?     @db.VarChar(500)
  websiteUrl   String?     @db.VarChar(500)
  tier         SponsorTier
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@map("sponsors")
}

model OrganizerProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  title        String   @db.VarChar(100)
  displayOrder Int      @default(0)
  isFeatured   Boolean  @default(false)
  society      Society  @default(STUDENT_BRANCH)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizer_profiles")
}

model ContentBlock {
  id          Int         @id @default(autoincrement())
  key         String      @unique @db.VarChar(100)
  value       String      @db.LongText
  type        ContentType @default(TEXT)
  updatedById Int?
  updatedAt   DateTime    @updatedAt

  updatedBy User? @relation("ContentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("content_blocks")
}

model FAQ {
  id           Int         @id @default(autoincrement())
  question     String      @db.VarChar(500)
  answer       String      @db.Text
  category     FAQCategory @default(REGISTRATION)
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)

  @@map("faqs")
}

model EventSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.VarChar(500)
  updatedAt DateTime @updatedAt

  @@map("event_settings")
}

model ContactSubmission {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @db.VarChar(255)
  subject    String   @db.VarChar(200)
  message    String   @db.Text
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("contact_submissions")
}

model EmailLog {
  id             Int      @id @default(autoincrement())
  recipientEmail String   @db.VarChar(255)
  subject        String   @db.VarChar(300)
  status         String   @db.VarChar(20) // SENT | FAILED | QUEUED
  sentAt         DateTime @default(now())
  errorMessage   String?  @db.Text

  @@map("email_logs")
}
